# Copy to .env and edit if you want to change crawler behaviour. All values are optional.
HEADLESS=true                 # false = show the Chromium window while crawling
NAV_TIMEOUT_MS=25000          # per-page navigation timeout
MAX_RETRIES=2                 # retries for timeouts / 5xx errors (never for 403/429/CAPTCHA)
REQUEST_DELAY_SECONDS=1.5     # polite delay between pages on the same website
BATCH_SIZE=5                  # companies processed (and saved) per batch
MAX_DETAIL_PAGES_PER_COMPANY=8
RESPECT_ROBOTS_TXT=true
# JOBS_DB_PATH=database/jobs.db
